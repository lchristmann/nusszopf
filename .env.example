APP_NAME=Nusszopf
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nusszopf
DB_USERNAME=nusszopf
DB_PASSWORD=nusszopf

SESSION_DRIVER=redis
SESSION_LIFETIME=480
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
# Documents per search page ("Mehr laden" adds another); 50 is the historical value. Only browser tests change it.
# SEARCH_PAGE_SIZE=50

# Project-location autocomplete (LocationIQ, https://locationiq.com). Without a
# key, "Ortsgebunden" projects cannot pick a place; see docs/deployment/README.md.
LOCATIONIQ_KEY=

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="mail@nusszopf.org"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"
