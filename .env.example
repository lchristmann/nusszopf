APP_NAME=Nusszopf
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nusszopf
DB_USERNAME=nusszopf
DB_PASSWORD=nusszopf

SESSION_DRIVER=redis
SESSION_LIFETIME=480
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
# Documents per search page ("Mehr laden" adds another); 50 is the historical value. Only browser tests change it.
# SEARCH_PAGE_SIZE=50

# Project-location autocomplete (LocationIQ, https://locationiq.com). Without a
# key, "Ortsgebunden" projects cannot pick a place; see docs/deployment/README.md.
LOCATIONIQ_KEY=
# Development and CI use the bundled stub (compose.dev.yaml) unless you point this at the real API.
# LOCATIONIQ_URL=https://api.locationiq.com/v1/autocomplete.php

# Google login (docs/authentication/README.md §3). Without these, the "Google"
# button on the login screen is hidden and its routes 404; see docs/deployment/README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Development/CI deliver to the bundled Mailpit catcher (compose.dev.yaml). Production sends through Resend
# (recommended) or an SMTP relay: docs/deployment/README.md, "Sending mail".
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# To try real delivery instead (docs/deployment/README.md): MAIL_MAILER=resend and a key.
# RESEND_API_KEY=
MAIL_FROM_ADDRESS="mail@nusszopf.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Your instance's identity and legal pages (docs/deployment/README.md, "Legal pages") --------------
# The address shown wherever the app says "write to us": the error page, Home, Profile, the e-mails, the
# "report project" link and the downloadable contact card. Empty = MAIL_FROM_ADDRESS.
NUSSZOPF_CONTACT_EMAIL=
# The folder holding legal-notice.md (Impressum), legal-policy.md (Rechtliches) and privacy.md
# (Datenschutz). Empty = the app's ./legal folder, which docker-compose.yaml mounts from ./legal.
NUSSZOPF_LEGAL_PATH=

# New accounts per address per 15 minutes (empty = 10; the dev stack raises it for browser tests) and the /health
# token (docs/deployment/operations.md). Both optional.
# NUSSZOPF_REGISTER_LIMIT=
# HEALTH_TOKEN=

# Public demo mode (docs/deployment/demo.md): only for a demonstration instance such as nusszopf.org. Off = an
# ordinary installation.
# NUSSZOPF_DEMO=false

FILESYSTEM_DISK=local

# Stored with every newsletter consent record (decision A-1).
NEWSLETTER_CONSENT_VERSION=1
