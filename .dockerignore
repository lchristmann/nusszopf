# Keep a working copy's local state out of the image build context (`COPY . .` in docker/php/Dockerfile):
# a host `vendor`/`node_modules` would replace the production (--no-dev) install, a host `.env` would ship
# secrets inside the image, and cached framework files list dev-only packages.
.git
.env
.env.*
!.env.example
vendor
node_modules
public/build
public/hot
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
# Uploaded files (avatars, Livewire's temporary uploads). Docker copies an image's storage/app into every new
# laravel-storage volume, so a working copy's uploads would reach each installation made from a local build (P-10, P10-04).
storage/app/public/*
!storage/app/public/.gitignore
storage/app/private/*
!storage/app/private/.gitignore
test-results
playwright-report
# An operator's own legal texts (docker-compose.yaml mounts ./legal at run time instead)
legal
.historical-harness
tests/Visual/reference
tests/Visual/baselines
