# Nusszopf — configuration of a production installation. Copy to `.env` next to docker-compose.yaml
# (or run install.sh, which does this and generates the secrets). Lines marked REQUIRED must be set.

# The release to run. Upgrading = change this, `docker compose pull`, `docker compose up -d`.
# REQUIRED
NUSSZOPF_VERSION=

# --- Application -----------------------------------------------------------------------------------
APP_NAME=Nusszopf
APP_ENV=production
APP_DEBUG=false
# REQUIRED. Generate once:  docker compose run --rm --no-deps --entrypoint php php-fpm artisan key:generate --show
# Losing it makes sessions and anything encrypted with it unreadable — keep it with your backups.
APP_KEY=
# REQUIRED. The public address, including https:// (used in links and e-mails).
APP_URL=https://nusszopf.example.org
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Where the web container listens on the host. Behind a reverse proxy on the same machine use
# APP_BIND=127.0.0.1 so only the proxy can reach it.
APP_BIND=0.0.0.0
APP_PORT=8080

# Which reverse proxies to believe about the original address and https: `*` (any), or a comma-separated
# list of proxy addresses. Needed behind a TLS-terminating proxy; leave empty without one.
TRUSTED_PROXIES=*
# Set to true once the site is served over https only.
SESSION_SECURE_COOKIE=true

# Logs go to the container output: `docker compose logs -f`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (PostgreSQL, run by this stack) ---------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nusszopf
DB_USERNAME=nusszopf
# REQUIRED
DB_PASSWORD=

# --- Redis (run by this stack): sessions, cache, queue ------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=480
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis

# --- Search (Meilisearch, run by this stack) ----------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
# REQUIRED, at least 16 characters.
MEILISEARCH_KEY=

# --- Project location search (https://locationiq.com; without a key only location-independent projects) ---
LOCATIONIQ_KEY=

# --- Google login (docs/authentication/README.md §3) -------------------------------------------------
# Without these, the "Google" button on the login screen is hidden and its routes 404 — password/username
# login is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# --- Mail (contact form, welcome/password-reset/verification/blocked-account e-mails) ----------------
# Without a working relay, every mail-triggering action (registration, "forgot password", the contact
# form, a login lockout notice) still completes normally — the mail is queued, then delivery keeps
# retrying and finally fails visibly in `failed_jobs` (docs/deployment/operations.md).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="mail@nusszopf.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Monitoring --------------------------------------------------------------------------------------
# /health answers 200 "ok" or 503 "degraded". With a token set, a request carrying it
# (Authorization: Bearer <token>) also gets the version and each check's result. Optional.
HEALTH_TOKEN=
